{
  "Insert c++ code": {
    "prefix": "cbcpp",
    "body": ["```cpp", "${1: }", "```"],
    "description": "Insert fenced C++ code block"
  },
  "Insert code block": {
    "prefix": "cb",
    "body": ["```${1}", "```"],
    "description": "Insert fenced code block"
  },
  "Insert arrow": {
    "prefix": "ar",
    "body": ["→"],
    "description": "Insert Arrow"
  },
  "Insert math block": {
    "prefix": "math",
    "body": ["\\$\\$", "${1}", "\\$\\$"],
    "description": "Insert fenced LaTeX math block"
  },
  "Insert y hat": {
    "prefix": "yh",
    "body": ["ŷ"],
    "description": "Insert y-hat (ŷ)"
  },
  "Insert in Symbol (∈)": {
    "prefix": "in",
    "body": ["∈"],
    "description": "Insert in Symbol (∈)"
  },
  "Insert sum Symbol (∑)": {
    "prefix": "sum",
    "body": ["∑"],
    "description": "Insert sum Symbol (∑)"
  },
  "Insert infinity": {
    "prefix": "inf",
    "body": ["∞"],
    "description": "Insert infinity (∞)"
  },
  "Insert left arrow": {
    "prefix": "lar",
    "body": ["←"],
    "description": "Insert left arrow (←)"
  },
  "Insert neq": {
    "prefix": "lar",
    "body": ["≠"],
    "description": "Insert not equal sign (≠)"
  },
  "Insert implies": {
    "prefix": "imp",
    "body": ["⇒"],
    "description": "Insert implies arrow (⇒)"
  },
  "Insert Delta ": {
    "prefix": "delta",
    "body": ["Δ"],
    "description": "Insert Delta (Δ)"
  },
  "Insert (lower) delta ": {
    "prefix": "ldelta",
    "body": ["δ"],
    "description": "Insert lowercase delta (δ)"
  },
  "Insert lambda": {
    "prefix": "lam",
    "body": ["λ"],
    "description": "Insert lambda (λ)"
  },
  "Insert plus/minus": {
    "prefix": "pm",
    "body": ["±"],
    "description": "Insert plus/minus (±)"
  }
}
