{
  "Insert c++ code": {
    "prefix": "cbcpp",
    "body": ["```cpp", "${1: }", "```"],
    "description": "Insert fenced C++ code block"
  },
  "Insert code block": {
    "prefix": "cb",
    "body": ["```${1}", "```"],
    "description": "Insert fenced code block"
  },
  "Insert arrow": {
    "prefix": "ar",
    "body": ["→"],
    "description": "Insert Arrow"
  },
  "Insert math block": {
    "prefix": "math",
    "body": ["\\$\\$", "${1}", "\\$\\$"],
    "description": "Insert fenced LaTeX math block"
  },
  "Insert y hat": {
    "prefix": "yh",
    "body": ["ŷ"],
    "description": "Insert y-hat (ŷ)"
  },
  "Insert in Symbol (∈)": {
    "prefix": "in",
    "body": ["∈"],
    "description": "Insert in Symbol (∈)"
  },
  "Insert sum Symbol (∑)": {
    "prefix": "sum",
    "body": ["∑"],
    "description": "Insert sum Symbol (∑)"
  }
}
